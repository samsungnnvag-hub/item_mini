# Copy thành .env và điền thông tin Supabase (dùng service_role, KHÔNG anon key)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Bucket Storage (tạo bucket public trong Supabase Dashboard)
SUPABASE_BUCKET=quanao

# Thư mục chứa ảnh .webp (mặc định = thư mục gốc repo quanao_mini)
# SOURCE_DIR=../../
